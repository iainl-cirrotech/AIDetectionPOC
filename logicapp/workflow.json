{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "mailboxAddress": {
        "type": "String"
      },
      "mailSubjectFilter": {
        "type": "String"
      },
      "detectorUrl": {
        "type": "String"
      },
      "detectorApiKey": {
        "type": "SecureString"
      }
    },
    "triggers": {
      "When_a_new_email_arrives": {
        "type": "ApiConnection",
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        },
        "splitOn": "@triggerOutputs()?['body/value']",
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs",
              "outputs"
            ]
          }
        },
        "inputs": {
          "host": {
            "connection": {
              "name": "@parameters('$connections')['office365']['connectionId']"
            }
          },
          "method": "get",
          "path": "/v3/Mail/OnNewEmail",
          "queries": {
            "folderPath": "Inbox",
            "importance": "Any",
            "fetchOnlyWithAttachment": true,
            "includeAttachments": true,
            "subjectFilter": "@parameters('mailSubjectFilter')"
          }
        }
      }
    },
    "actions": {
      "Initialize_analysis_results": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "analysisResults",
              "type": "Array",
              "value": []
            }
          ]
        },
        "runAfter": {}
      },
      "Has_attachments": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greater": [
                "@length(coalesce(triggerOutputs()?['body/attachments'], json('[]')))",
                0
              ]
            },
            {
              "not": {
                "equals": [
                  "@toLower(coalesce(triggerOutputs()?['body/from'], ''))",
                  "@toLower(parameters('mailboxAddress'))"
                ]
              }
            },
            {
              "not": {
                "startsWith": [
                  "@toLower(coalesce(triggerOutputs()?['body/subject'], ''))",
                  "image screening result:"
                ]
              }
            }
          ]
        },
        "actions": {
          "For_each_attachment": {
            "type": "Foreach",
            "foreach": "@triggerOutputs()?['body/attachments']",
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            },
            "actions": {
              "Is_image": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "startsWith": [
                        "@toLower(coalesce(items('For_each_attachment')?['contentType'], ''))",
                        "image/"
                      ]
                    }
                  ]
                },
                "actions": {
                  "Send_to_detector": {
                    "type": "Http",
                    "runtimeConfiguration": {
                      "contentTransfer": {
                        "transferMode": "Chunked"
                      },
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "inputs": {
                      "method": "POST",
                      "uri": "@parameters('detectorUrl')",
                      "headers": {
                        "Content-Type": "@items('For_each_attachment')?['contentType']",
                        "x-filename": "@items('For_each_attachment')?['name']",
                        "x-email-subject": "@triggerOutputs()?['body/subject']",
                        "x-email-sender": "@triggerOutputs()?['body/from']",
                        "x-email-received": "@triggerOutputs()?['body/receivedDateTime']",
                        "x-correlation-id": "@guid()",
                        "x-api-key": "@parameters('detectorApiKey')"
                      },
                      "body": "@base64ToBinary(items('For_each_attachment')?['contentBytes'])"
                    }
                  },
                  "Append_successful_result": {
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "analysisResults",
                      "value": "@concat('<strong>', replace(replace(replace(coalesce(items('For_each_attachment')?['name'], 'Unnamed image'), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '</strong><br>Overall result: ', coalesce(body('Send_to_detector')?['overall']?['label'], 'Result unavailable'), '<br>Classifier score: ', if(equals(body('Send_to_detector')?['detection']?['ai_probability'], null), 'not available', concat(formatNumber(mul(float(body('Send_to_detector')?['detection']?['ai_probability']), 100), '0.0'), '%')), ' (', coalesce(body('Send_to_detector')?['detection']?['band'], 'Unknown'), ')<br>C2PA: ', if(equals(body('Send_to_detector')?['provenance']?['c2pa']?['present'], true), 'present', 'absent'), '<br>Reference: ', coalesce(body('Send_to_detector')?['correlation_id'], 'not available'))"
                    },
                    "runAfter": {
                      "Send_to_detector": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "runAfter": {
          "Initialize_analysis_results": [
            "Succeeded"
          ]
        }
      },
      "Send_result_if_any": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greater": [
                "@length(variables('analysisResults'))",
                0
              ]
            },
            {
              "not": {
                "equals": [
                  "@coalesce(triggerOutputs()?['body/from'], '')",
                  ""
                ]
              }
            },
            {
              "not": {
                "equals": [
                  "@toLower(coalesce(triggerOutputs()?['body/from'], ''))",
                  "@toLower(parameters('mailboxAddress'))"
                ]
              }
            }
          ]
        },
        "actions": {
          "Send_result_email": {
            "type": "ApiConnection",
            "runtimeConfiguration": {
              "secureData": {
                "properties": [
                  "inputs",
                  "outputs"
                ]
              }
            },
            "inputs": {
              "host": {
                "connection": {
                  "name": "@parameters('$connections')['office365']['connectionId']"
                }
              },
              "method": "post",
              "path": "/v2/Mail",
              "body": {
                "To": "@triggerOutputs()?['body/from']",
                "Subject": "@concat('Image screening result: ', coalesce(triggerOutputs()?['body/subject'], '(no subject)'))",
                "Body": "@concat('<p>We processed the image attachment(s) received by ', parameters('mailboxAddress'), '.</p><p>', join(variables('analysisResults'), '<br><br>'), '</p><p><strong>Important:</strong> This is an automated screening result, not proof that an image is genuine or fraudulent. Classifier results are probabilistic, and missing C2PA credentials do not indicate fakery.</p><hr><p style=\"color:#647080;font-size:12px;text-align:center\">&copy; 2026 Cirrotech Ltd. All rights reserved.</p>')",
                "Importance": "Normal"
              }
            }
          }
        },
        "runAfter": {
          "Has_attachments": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ]
        }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "$connections": {
      "value": {
        "office365": {
          "connectionId": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
          "connectionName": "[parameters('office365ConnectionName')]",
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/office365')]"
        }
      }
    }
  }
}
